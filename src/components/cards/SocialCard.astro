---
const contactCards = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/lounis-khalfallah/",
    icon: "linkedin",
  },
  {
    name: "Email",
    url: "https://mail.google.com/mail/?view=cm&fs=1&to=louniskhal@gmail.com",
    icon: "email",
  },
];
---

<div class="social-cards-wrapper">
  <div class="social-list">
    {
      contactCards.map((card) => (
        <a
          href={card.url}
          class={`social-item social-${card.icon}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={card.name}
        >
          <span class="social-icon">
            {card.icon === "linkedin" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3A2.05 2.05 0 1 0 4.75 7.1 2.05 2.05 0 0 0 4.75 3ZM21 13.85c0-3.75-2-5.5-4.65-5.5a4.02 4.02 0 0 0-3.6 1.98h-.05V8.5H9.35V21h3.5v-6.18c0-1.63.3-3.2 2.33-3.2 2 0 2.03 1.86 2.03 3.3V21H21v-7.15Z"
                />
              </svg>
            )}

            {card.icon === "email" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 6.5h18v11H3z M3 7l9 7 9-7"
                />
              </svg>
            )}
          </span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .social-cards-wrapper {
    width: 180px;
    height: 100px;
    overflow: visible;
  }

  .social-list {
    position: relative;
    width: 180px;
    height: 100px;
  }

  .social-item {
    position: absolute;
    top: 8px;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 16px;
    color: white;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    transition:
      transform 0.35s ease,
      box-shadow 0.25s ease;
  }

  .social-linkedin {
    z-index: 2;
    background: linear-gradient(135deg, #0a66c2, #38bdf8);
    transform: rotate(-5deg);
  }

  .social-email {
    z-index: 1;
    background: linear-gradient(135deg, #7c3aed, #c084fc);
    transform: translateX(8px) translateY(8px) rotate(4deg);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
  }

  .social-cards-wrapper:hover .social-linkedin {
    transform: translateX(0) rotate(-5deg);
  }

  .social-cards-wrapper:hover .social-email {
    transform: translateX(86px) translateY(8px) rotate(4deg);
  }

  .social-item:hover {
    z-index: 3;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
  }

  .social-linkedin:hover {
    transform: translateY(-4px) rotate(-5deg) scale(1.04);
  }

  .social-email:hover {
    transform: translateX(86px) translateY(4px) rotate(4deg) scale(1.04);
  }
</style>