---
const { className = "" } = Astro.props;
---

<div class={`matter-wrapper ${className}`}>
  <div class="tricks-view">
    <div class="tricks-matter">
      <div class="tricks-canvas"></div>

      <div class="tricks-elements">
        <div class="tricks-element"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import Matter from "matter-js";

  const {
    Engine,
    Render,
    Runner,
    Bodies,
    Composite,
    Mouse,
    MouseConstraint,
    Events,
    Body,
  } = Matter;

  let animationInitialized = false;

  const initTricksAnimation = () => {
    if (animationInitialized) return;

    const container = document.querySelector(
      ".matter-wrapper"
    ) as HTMLElement | null;

    const canvasContainer = document.querySelector(
      ".tricks-canvas"
    ) as HTMLElement | null;

    if (!container || !canvasContainer) return;

    animationInitialized = true;

    const margin = 1;
    const noRotate = false;
    const scaleFactor = 0.75;

    const iconUrls = [
      "/assets/stack/excel.png",
      "/assets/stack/google-analytics.png",
      "/assets/stack/google-ads.png",
      "/assets/stack/photoshop.png",
      "/assets/stack/figma.png",
      "/assets/stack/html.png",
      "/assets/stack/css.png",
      "/assets/stack/screaming-frog.png",
      "/assets/stack/semrush.png",
      "/assets/stack/salesforce.png",
      "/assets/stack/wordpress.png",
      "/assets/stack/shopify.png",
      "/assets/stack/ahrefs.png",
      "/assets/stack/google-search-console.png",
      "/assets/stack/canva.png",
    ];

    const engine = Engine.create();
    engine.gravity.y = 1;

    const world = engine.world;

    let width = container.clientWidth;
    let height = container.clientHeight;

    const render = Render.create({
      element: canvasContainer,
      engine,
      options: {
        width,
        height,
        wireframes: false,
        background: "transparent",
        pixelRatio: window.devicePixelRatio || 1,
      },
    });

    render.canvas.style.pointerEvents = "auto";
    render.canvas.style.touchAction = "none";

    Render.run(render);

    const runner = Runner.create();
    Runner.run(runner, engine);

    const createBoundaries = () => {
      return [
        // Mur du bas
        Bodies.rectangle(
          width / 2,
          height + margin,
          width,
          margin * 2,
          {
            isStatic: true,
            render: { visible: false },
          }
        ),

        // Mur de gauche
        Bodies.rectangle(
          -margin,
          height / 2,
          margin * 2,
          height,
          {
            isStatic: true,
            render: { visible: false },
          }
        ),

        // Mur de droite
        Bodies.rectangle(
          width + margin,
          height / 2,
          margin * 2,
          height,
          {
            isStatic: true,
            render: { visible: false },
          }
        ),
      ];
    };

    const boundaries = createBoundaries();

    Composite.add(world, boundaries);

    const images: HTMLImageElement[] = [];

    const preloadImages = async () => {
      const promises = iconUrls.map((url) => {
        return new Promise<HTMLImageElement>((resolve) => {
          const image = new Image();

          image.onload = () => resolve(image);
          image.onerror = () => resolve(image);
          image.src = url;
        });
      });

      const loadedImages = await Promise.all(promises);
      images.push(...loadedImages);
    };

    class IconBody {
      body: Matter.Body;
      image: HTMLImageElement;
      width: number;
      height: number;

      constructor(
        x: number,
        y: number,
        image: HTMLImageElement
      ) {
        this.image = image;

        const imageWidth = image.naturalWidth || 100;
        const imageHeight = image.naturalHeight || 100;
        const ratio = imageWidth / imageHeight;

        this.width = 90 * scaleFactor;
        this.height = this.width / ratio;

        this.body = Bodies.rectangle(
          x,
          y,
          this.width,
          this.height,
          {
            restitution: 0.7,
            friction: 0.4,
            frictionAir: 0.01,
            density: 0.002,

            chamfer: {
              radius: 8,
            },

            render: {
              visible: false,
            },
          }
        );

        if (noRotate) {
          Body.setInertia(this.body, Infinity);
        }
      }

      draw(context: CanvasRenderingContext2D) {
        const position = this.body.position;
        const angle = this.body.angle;

        context.save();

        context.translate(position.x, position.y);
        context.rotate(angle);

        context.drawImage(
          this.image,
          -this.width / 2,
          -this.height / 2,
          this.width,
          this.height
        );

        context.restore();
      }
    }

    const iconBodies: IconBody[] = [];

    const createIcons = () => {
      const shuffledIcons = [...images];

      for (let i = shuffledIcons.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));

        [shuffledIcons[i], shuffledIcons[j]] = [
          shuffledIcons[j],
          shuffledIcons[i],
        ];
      }

      shuffledIcons.forEach((image, index) => {
        const x =
          Math.random() * Math.max(width - 140, 40) + 70;

        const y = -100 - index * 80;

        const icon = new IconBody(x, y, image);

        iconBodies.push(icon);

        Composite.add(world, icon.body);
      });
    };

    const setupMouse = () => {
      const mouse = Mouse.create(render.canvas);

      const mouseConstraint = MouseConstraint.create(
        engine,
        {
          mouse,

          constraint: {
            stiffness: 0.2,

            render: {
              visible: false,
            },
          },
        }
      );

      Composite.add(world, mouseConstraint);

      render.mouse = mouse;
    };

    const setupDrawing = () => {
      Events.on(render, "afterRender", () => {
        const context = render.context;

        iconBodies.forEach((icon) => {
          icon.draw(context);
        });
      });
    };

    const resize = () => {
      width = container.clientWidth;
      height = container.clientHeight;

      render.canvas.width =
        width * (window.devicePixelRatio || 1);

      render.canvas.height =
        height * (window.devicePixelRatio || 1);

      render.options.width = width;
      render.options.height = height;

      Render.setPixelRatio(
        render,
        window.devicePixelRatio || 1
      );

      Body.setPosition(boundaries[0], {
        x: width / 2,
        y: height + margin,
      });

      Body.setPosition(boundaries[1], {
        x: -margin,
        y: height / 2,
      });

      Body.setPosition(boundaries[2], {
        x: width + margin,
        y: height / 2,
      });

      Body.setVertices(boundaries[0], [
        { x: 0, y: height },
        { x: width, y: height },
        { x: width, y: height + margin * 2 },
        { x: 0, y: height + margin * 2 },
      ]);

      Body.setVertices(boundaries[1], [
        { x: -margin * 2, y: 0 },
        { x: 0, y: 0 },
        { x: 0, y: height },
        { x: -margin * 2, y: height },
      ]);

      Body.setVertices(boundaries[2], [
        { x: width, y: 0 },
        { x: width + margin * 2, y: 0 },
        { x: width + margin * 2, y: height },
        { x: width, y: height },
      ]);
    };

    const start = async () => {
      await preloadImages();

      createIcons();
      setupMouse();
      setupDrawing();

      window.addEventListener("resize", resize);
    };

    start();
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          initTricksAnimation();
          observer.disconnect();
        }
      });
    },
    {
      threshold: 0.1,
    }
  );

  const matterWrapper = document.querySelector(
    ".matter-wrapper"
  );

  if (matterWrapper) {
    observer.observe(matterWrapper);
  }
</script>

<style is:global>
  .matter-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    overflow: hidden;
  }

  .tricks-view {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .tricks-matter {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .tricks-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 10;
    pointer-events: auto;
    touch-action: none;
  }

  .tricks-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: auto;
    touch-action: none;
  }

  .tricks-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .tricks-element {
    width: 100px;
    height: 100px;
  }
</style>