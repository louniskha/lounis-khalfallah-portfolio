---
import { getCollection } from "astro:content";
import Pagination from "@/components/widgets/Pagination.astro";
import BlogCard from "@/components/cards/BlogCard.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Button from "@/components/ui/Button.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";

const {
  title = "Derniers articles",
  description = "",
  limit = 3,
  listPage = false,
  showViewAllButton = true,
  pagination = {
    enable: false,
    currentPage: 1
  },
  postsPerPage = 3
} = Astro.props;

// Récupération des articles du blog
const allPosts = await getCollection("post");

// Tri des articles par date de publication
let posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Recherche de l'article mis en avant
const featuredPost = posts.find((post) => post.data.featured);

// Retrait de l'article mis en avant de la liste principale
if (featuredPost && listPage) {
  posts = posts.filter((post) => post.data.featured !== true);
}

// Calcul du nombre total de pages
const totalPages = Math.ceil(posts.length / postsPerPage);

// Affichage des articles de la page actuelle
if (pagination.enable) {
  const indexOfLastPost = pagination.currentPage * postsPerPage;
  const indexOfFirstPost = indexOfLastPost - postsPerPage;
  posts = posts.slice(indexOfFirstPost, indexOfLastPost);
} else if (!listPage) {
  posts = posts.slice(0, limit);
}

// Ajout des liens aux articles
const postsWithLinks = posts.map(post => {
  const link = `/blog/${post.id}`;

  return {
    ...post,
    data: {
      ...post.data,
      link
    }
  };
});

// Création de la version liée de l'article mis en avant
const featuredPostWithLink = featuredPost ? {
  ...featuredPost,
  data: {
    ...featuredPost.data,
    link: `/blog/${featuredPost.id}`
  }
} : null;
---

<!-- Section de l'article mis en avant -->
{listPage && featuredPostWithLink && pagination.currentPage === 1 && (
  <section class="mb-16">
    <div class="site-container">
      <h2 class="text-3xl font-brand mb-6 text-neutral-800 dark:text-white">
        <AnimatedText
          delay={0.75}
          stagger={0.08}
          content="À la une"
        />
      </h2>

      <div class="dark:from-neutral-900 dark:to-neutral-800 p-1 rounded-2xl">
        <BlogCard
          layout="horizontal"
          content={{ ...featuredPostWithLink.data, ...featuredPostWithLink }}
          data-aos="fade-up-sm"
          data-aos-delay="1000"
        />
      </div>
    </div>
  </section>
)}

<section>
  <div class="site-container space-y-10 md:space-y-16">

    <!-- Titre de la section -->
    {!listPage && title && (
      <SectionHeader
        title={title}
        description={description}
      />
    )}

    <!-- Titre de la page du blog -->
    {listPage && title && (
      <div class="mx-auto">
        <h2 class="text-3xl font-brand text-neutral-800 dark:text-white">
          {title}
        </h2>
      </div>
    )}

    <!-- Liste des articles -->
    <div class="grid gap-x-6 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
      {postsWithLinks && postsWithLinks.map((post, index) => (
        <BlogCard
          content={{ ...post.data, ...post }}
          data-aos={
            !pagination.enable &&
            (Math.floor(index / 3) % 2 === 0
              ? "fade-right-sm"
              : "fade-left-sm")
          }
          data-aos-delay={
            !pagination.enable &&
            ((index % 3) + 1) * 200
          }
        />
      ))}
    </div>

    <!-- Pagination -->
    {listPage && totalPages > 1 && (
      <Pagination
        collection="blog"
        currentPage={pagination.currentPage || 1}
        totalPages={totalPages}
      />
    )}

  </div>

  <!-- Bouton pour afficher tous les articles -->
  {!listPage && showViewAllButton && (
    <div class="flex justify-center mt-12 mb-12">
      <Button
        url="/blog"
        className="w-full max-w-60"
      >
        Voir tous les articles
      </Button>
    </div>
  )}
</section>