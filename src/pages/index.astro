---
import Button from "../components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import HeroCard from "@/components/home/HeroCard.astro";
import Layout from "@/layouts/Layout.astro";
import FeaturedWork from "../components/sections/FeaturedWork.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import SocialCard from "@/components/cards/SocialCard.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import Explore from "@/components/sections/Explore.astro";
---

<Layout
  title="Lounis Khalfalah — Chef de projet Marketing Digital"
  description="Portfolio de Lounis Khalfalah, Chef de projet Marketing Digital. Découvrez ses projets web, e-commerce, SEO et GEO."
  keywords="Lounis Khalfalah, Chef de projet Marketing Digital, Marketing Digital, WordPress, Shopify, SEO, GEO, HTML, CSS, E-commerce"
>
  <div
    class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-20 xl:px-0"
  >
    <div
      class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-16"
    >
      <div
        class="relative w-full md:max-w-[520px] md:w-1/2 text-center sm:text-left sm:-mt-8"
      >
        <!-- Main title -->
        <h1 class="mb-4">
          <AnimatedText
            content="Faire de chaque projet une expérience qui a du sens"
            delay={0.1}
            duration={0.5}
            stagger={0.06}
            class="text-5xl text-pri leading-tight md:text-4xl lg:text-6xl font-brand"
          />
        </h1>

        <!-- Professional title -->
        <div class="mb-4">
          <AnimatedText
            content="Lounis Khalfallah - Chef de projet Marketing Digital"
            delay={0.25}
            duration={0.5}
            stagger={0.02}
            class="text-xl font-medium text-neutral-800 dark:text-neutral-200"
          />
        </div>

        <!-- Introduction -->
        <div class="mb-3">
          <AnimatedText
            content="Je pilote des projets digitaux de leur conception à leur mise en ligne, avec une approche centrée sur les objectifs business, l’expérience utilisateur et la visibilité en ligne."
            delay={0.4}
            duration={0.5}
            stagger={0.01}
            class="text-base text-neutral-700 dark:text-neutral-300"
          />
        </div>

        <!-- Experience -->
        <div class="mb-4">
          <AnimatedText
            content="Depuis 4 ans, j’interviens sur des projets web et e-commerce, notamment avec WordPress et Shopify. Je travaille également sur l’optimisation SEO et GEO, avec une attention particulière portée à la visibilité et à la performance des projets."
            delay={0.55}
            duration={0.5}
            stagger={0.01}
            class="text-base text-neutral-700 dark:text-neutral-300"
          />
        </div>

        <!-- CTA -->
        <div
          data-aos="fade-up-sm"
          data-aos-delay="900"
          data-aos-duration="500"
          data-aos-once="true"
        >
          <Button
            url="/works"
            type="fill"
            className="m-auto mt-4 text-center sm:text-left sm:m-0 sm:mt-6 max-w-[200px]"
          >
            Voir mes projets
          </Button>
        </div>

        <!-- Social links -->
        <div
          class="social mt-8 mb-8"
          data-aos="fade-up-sm"
          data-aos-delay="1000"
          data-aos-duration="600"
          data-aos-once="true"
        >
          <SocialCard displaySocialIds={[1, 2, 3, 4]} />
        </div>
      </div>

      <!-- Featured project -->
      <div
        class="relative justify-end w-full mt-16 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
        data-aos="fade-left-sm"
        data-aos-delay="300"
        data-aos-duration="800"
        data-aos-once="true"
      >
        <HeroCard
          imageUrl="/assets/home/gradientshub.jpg"
          title="Cosm’Ethique"
          link="#"
        />
      </div>
    </div>
  </div>

  <!-- Explore -->
  <section
    class="mt-26 mb-12"
    data-aos="fade-up-sm"
    data-aos-delay="100"
    data-aos-duration="600"
    data-aos-once="true"
  >
    <Explore title="Découvrir ↓" />
  </section>

  <!-- Featured work -->
  <section
    class="mt-26 mb-12"
    data-aos="fade-up-sm"
    data-aos-delay="100"
    data-aos-duration="600"
    data-aos-once="true"
  >
    <FeaturedWork
      title="Mes projets ↓"
      description="Découvrez les projets que j’ai conçus et réalisés !"
      limit={5}
    />
  </section>

  <!-- Articles -->
  <section
    class="mt-26 mb-12"
    data-aos="fade-up-sm"
    data-aos-delay="100"
    data-aos-duration="600"
    data-aos-once="true"
  >
    <BlogSection
      title="Réflexions & articles ↓"
      description="Mes réflexions autour du marketing digital, du web, du SEO et des nouvelles pratiques digitales."
      showViewAllButton={true}
    />
  </section>
</Layout>
