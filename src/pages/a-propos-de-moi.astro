---
import {
  ArrowUpRight,
  Accessibility,
  BarChart3,
  Code,
  Globe,
  Mail,
  Megaphone,
  PenTool,
  Search,
  Users,
  Monitor,
  Palette,
  Smartphone,
  Zap,
} from "@lucide/astro";
import { siteConfig } from "@/config/site.js";
import social from "@/collections/social.json";
import AboutExperience from "@/components/elements/AboutExperience.astro";
import Button from "@/components/ui/Button.astro";
import Matter from "@/components/ui/Matter.astro";
import Layout from "@/layouts/Layout.astro";
import Toc from "@/components/widgets/Toc.astro";

const headings = [
  { depth: 2, slug: "about-me", text: "À propos de moi" },
  { depth: 2, slug: "expertise", text: "Domaines d’expertise" },
  { depth: 2, slug: "tool-stack", text: "Compétences techniques" },
  { depth: 2, slug: "experience", text: "Expérience professionnelle" },
  { depth: 2, slug: "centres-d-interet", text: "Centres d’intérêt" },
];

const filtered = headings.filter((heading) => heading.depth <= 3);

const experiences = [
  {
    dates: "2023 – 2025",
    role: "Chargé de marketing digital",
    company: "Groupe Batisanté",
    description:
      "SEO on-page, maillage interne, méta-descriptions, suivi Google Analytics 4 et Search Console. Gestion d’environ 80 fiches produits du catalogue B2B AVOND, campagnes CRM et e-mailing, veille concurrentielle, participation à des salons professionnels et amélioration de l’expérience utilisateur.",
    logo: "/assets/avatar.png",
  },
  {
    dates: "2023",
    role: "Commercial B2B",
    company: "Youlead",
    description:
      "Prospection téléphonique et terrain, analyse des besoins, conseil, négociation, closing et fidélisation d’un portefeuille de clients professionnels.",
    logo: "/assets/avatar.png",
  },
  {
    dates: "2021 – 2022",
    role: "Chargé de marketing & communication",
    company: "Vivest",
    description:
      "Rédaction de contenus SEO, gestion des réseaux sociaux, création de contenus, benchmarking et participation à des événements et salons professionnels.",
    logo: "/assets/avatar.png",
  },
];
---

<Layout title="À propos de moi">
  <div class="block px-7 pt-6 lg:hidden">
    <Toc headings={filtered} />
  </div>

  <div class="site-container relative mx-auto my-8">
    <div class="flex flex-col gap-8 lg:flex-row lg:gap-12 xl:gap-16">
      <aside class="relative hidden flex-shrink-0 lg:block lg:w-40 xl:w-50">
        <div class="toc-sticky-wrapper">
          <Toc headings={filtered} />
        </div>
      </aside>

      <main class="relative min-w-0 w-full flex-1">
        <div data-aos="fade-up-xs" data-aos-duration="500" data-aos-once="true">
          <h2 id="about-me" class="font-brand text-2xl tracking-tight sm:text-3xl lg:text-4xl">
            À propos de moi
          </h2>
          <div class="mt-4 mb-8 w-full border-b border-dashed border-b-gray-200 dark:border-b-neutral-700"></div>
        </div>

        <div
          class="mb-6 flex items-center gap-3"
          data-aos="fade-up-xs"
          data-aos-delay="100"
          data-aos-duration="500"
          data-aos-once="true"
        >
          <img
            src="/assets/avatar.png"
            alt="Portrait de Lounis Khalfallah"
            class="h-14 w-14 rounded-full"
          />
          <div class="flex items-center gap-3">
            <a
              href="https://lounis-khalfallah.fr/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-brand text-[24px] text-neutral-700 dark:text-neutral-100"
            >
              Lounis Khalfallah
            </a>
            <span class="text-[0.75em] text-neutral-400">|</span>
            <a
              href="https://www.linkedin.com/in/lounis-khalfallah/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 text-sm text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="h-4 w-4 fill-current">
                <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1A53.79 53.79 0 1 1 107.58 54a53.79 53.79 0 0 1-53.79 54.1zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
              </svg>
              LinkedIn
            </a>
          </div>
        </div>

        <p
          class="mt-2 mb-2 text-left font-brand text-3xl italic text-primary-strong dark:text-primary-light"
          data-aos="fade-up-xs"
          data-aos-delay="200"
          data-aos-duration="500"
          data-aos-once="true"
        >
          « Faire grandir la visibilité, la performance et l’expérience des projets digitaux. »
        </p>

        <div
          class="social"
          data-aos="fade-up-xs"
          data-aos-delay="300"
          data-aos-duration="600"
          data-aos-once="true"
        >
          <div class="mt-6 mb-8 flex flex-wrap items-center justify-start gap-2">
            <a
              href="https://www.linkedin.com/in/lounis-khalfallah/"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-[72px] w-[72px] flex-col justify-between rounded-xl bg-[#0a66c2] p-2 text-white transition-transform duration-300 hover:-translate-y-2 hover:rotate-[-4deg]"
              aria-label="Ouvrir le profil LinkedIn de Lounis Khalfallah"
            >
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current" aria-hidden="true">
                <path d="M6.5 8.2H3.2V20h3.3V8.2ZM4.85 3A2 2 0 1 0 4.85 7 2 2 0 0 0 4.85 3ZM20.8 13.2c0-3.55-1.9-5.2-4.45-5.2-2.05 0-2.97 1.13-3.48 1.92V8.2H9.55V20h3.32v-6.05c0-1.6.3-3.15 2.28-3.15 1.95 0 1.97 1.83 1.97 3.26V20h3.32l.36-6.8Z"/>
              </svg>
              <span class="text-[10px] font-semibold">LinkedIn</span>
            </a>

            <a
              href="https://mail.google.com/mail/?view=cm&fs=1&to=louniskhal@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-[72px] w-[72px] flex-col justify-between rounded-xl bg-[#7c3aed] p-2 text-white transition-transform duration-300 hover:-translate-y-2 hover:rotate-[-4deg]"
              aria-label="Envoyer un e-mail à Lounis Khalfallah"
            >
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
                <path d="M3 6.5h18v11H3z"/>
                <path d="m4 8 8 6 8-6"/>
              </svg>
              <span class="text-[10px] font-semibold">E-mail</span>
            </a>
          </div>
        </div>

        <div class="mt-4 mb-8 w-full border-b border-dashed border-b-gray-200 dark:border-b-neutral-700"></div>

        <p class="text-xl font-medium text-left text-neutral-800 dark:text-neutral-100">
          Je suis Lounis Khalfallah, chargé de marketing digital.
        </p>

        <p class="pt-4 pb-4 leading-[1.8] text-neutral-700 dark:text-neutral-200">
          Avec quatre ans d’expérience en marketing digital, j’interviens sur des sujets où visibilité,
          contenu et performance se rencontrent. J’aime comprendre un besoin, structurer une stratégie
          et transformer les idées en actions concrètes.
        </p>

        <p class="leading-[1.8] text-neutral-700 dark:text-neutral-200">
          SEO, CRM et e-mailing, gestion de catalogues e-commerce, analyse de données et amélioration de
          l’expérience utilisateur font partie de mon quotidien. Ma curiosité pour les outils et le
          développement me permet aussi de dialoguer facilement avec les enjeux techniques d’un projet.
        </p>

        <div class="mt-8 mb-16 flex items-center justify-start gap-3">
          <Button url="mailto:louniskhal@gmail.com">
            <Mail size={16} /> louniskhal@gmail.com
          </Button>
          <Button url={siteConfig.resume} type="fill">
            CV <ArrowUpRight size={16} />
          </Button>
        </div>

        <div class="mt-4 mb-8 w-full border-b border-dashed border-b-neutral-200 dark:border-b-neutral-700"></div>

        <section>
          <h2 id="expertise" class="mt-8 mb-2 font-brand text-[28px] text-neutral-800 dark:text-neutral-200">
            Domaines d’expertise
          </h2>

          <div class="mt-4 mb-12 flex w-full flex-wrap items-center justify-start gap-3">
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Palette size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Design produit numérique</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Globe size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Conception et design de sites web</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Zap size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Identité visuelle et stratégie de marque</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Monitor size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Prototypage et conception interactive</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Smartphone size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Conception d’interfaces et expérience utilisateur (UI/UX)</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Code size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Développement web</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Search size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Optimisation pour les moteurs de recherche (SEO)</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Megaphone size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Publicité sur les moteurs de recherche (SEA)</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <BarChart3 size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Analyse des données et mesure de performance</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Users size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Analyse et gestion de la relation client (CRM)</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <PenTool size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Stratégie de contenu et rédaction web</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Accessibility size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Accessibilité numérique</span>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2 rounded-xl bg-gradient-to-b from-[#f7f8f0] to-[#f1f2f9] px-5 py-4 dark:from-gray-900 dark:to-gray-800">
              <Globe size={22} />
              <span class="text-base font-medium text-neutral-700 dark:text-neutral-200">Optimisation pour les moteurs génératifs (GEO)</span>
            </div>
          </div>
        </section>

        <div class="mt-4 mb-8 w-full border-b border-dashed border-b-gray-200 dark:border-b-neutral-700"></div>

        <section>
          <h2 id="tool-stack" class="mt-12 mb-4 font-brand text-[28px] text-neutral-800 dark:text-neutral-200">
            Compétences techniques
          </h2>

          <div class="tool-stack-box relative h-[500px] w-full overflow-hidden rounded-xl border-accent/25 bg-white dark:bg-gray-900">
            <Matter />
          </div>
        </section>

        <div class="mt-12 mb-12 w-full border-b border-dashed border-b-gray-200 dark:border-b-neutral-700"></div>

        <section class="experience">
          <h2 id="experience" class="mt-12 mb-4 font-brand text-[28px] text-neutral-800 dark:text-neutral-200">
            Expérience professionnelle
          </h2>

          <div class="px-5 py-10">
            {
              experiences.map((experience, index) => (
                <div
                  class="border-l border-dashed border-gray-200 pb-10 last:border-l-0 dark:border-neutral-500"
                  data-aos="fade-up-xs"
                  data-aos-delay={200 + index * 100}
                  data-aos-duration="500"
                  data-aos-once="true"
                >
                  <AboutExperience
                    dates={experience.dates}
                    role={experience.role}
                    company={experience.company}
                    description={experience.description}
                    logo={experience.logo}
                  />
                </div>
              ))
            }
          </div>
        </section>

        <div class="mt-4 mb-8 w-full border-b border-dashed border-b-gray-200 dark:border-b-neutral-700"></div>

        <section id="centres-d-interet" class="interests-section">
          <div class="mb-8" data-aos="fade-up-xs" data-aos-duration="500" data-aos-once="true">
            <h2 class="mt-12 mb-3 font-brand text-[28px] text-neutral-800 dark:text-neutral-200">
              Centres d’intérêt
            </h2>
            <p class="max-w-3xl text-sm leading-7 text-neutral-700 dark:text-neutral-300">
              Les voyages nourrissent ma curiosité, la musculation m’apprend la régularité, le football
              me rappelle la force du collectif et l’investissement développe ma vision long terme.
            </p>
          </div>

          <div class="interests-layout">
            <div class="interest-globe-card" data-aos="fade-up-xs" data-aos-delay="100" data-aos-duration="600">
              <div class="interest-card-heading">
                <span class="interest-kicker">01 / CARNET DE VOYAGE</span>
                <span class="interest-status">24 pays visités</span>
              </div>

              <div class="globe-stage">
                <canvas
                  id="travel-globe"
                  width="600"
                  height="420"
                  aria-label="Globe interactif des pays visités"
                  role="img"
                ></canvas>
                <div id="globe-tooltip" class="globe-tooltip" aria-live="polite">
                  Clique sur un point pour découvrir le pays
                </div>
              </div>

              <div class="globe-caption">
                <span class="text-sm text-neutral-600 dark:text-neutral-300">Ma passion pour le voyage</span>
                <strong class="text-lg text-neutral-900 dark:text-white">24 destinations, une curiosité intacte</strong>
                <p class="text-sm leading-6 text-neutral-600 dark:text-neutral-400">
                  Chaque voyage est une occasion de découvrir une culture, de rencontrer de nouvelles
                  personnes et de changer de perspective.
                </p>
              </div>

              <div class="country-list" aria-label="Liste des pays visités">
                {
                  [
                    "Albanie",
                    "Algérie",
                    "Allemagne",
                    "Belgique",
                    "Bulgarie",
                    "Chypre",
                    "Danemark",
                    "Espagne",
                    "France",
                    "Grèce",
                    "Hongrie",
                    "Italie",
                    "Jersey",
                    "Luxembourg",
                    "Monaco",
                    "Norvège",
                    "Pologne",
                    "Portugal",
                    "Suisse",
                    "Suède",
                    "Thaïlande",
                    "Vietnam",
                    "Émirats arabes unis",
                    "États-Unis",
                  ].map((country) => <span>{country}</span>)
                }
              </div>
            </div>

            <div class="interest-cards-grid">
              <article class="interest-card interest-card-fitness">
                <div class="scene-topline"><span>02 / FORCE</span><span class="scene-live">● LIVE</span></div>
                <div class="scene fitness-scene" aria-hidden="true">
                  <div class="muscle-orbit orbit-one"></div>
                  <div class="muscle-orbit orbit-two"></div>
                  <svg class="fitness-figure" viewBox="0 0 260 170" role="img" aria-label="Personne animée réalisant un mouvement de musculation avec une barre">
                    <circle class="body-head" cx="130" cy="25" r="12"></circle>
                    <path class="body-torso" d="M112 43 Q130 35 148 43 L158 91 Q130 105 102 91 Z"></path>
                    <path class="body-arm arm-left" d="M112 48 L82 77 L56 61"></path>
                    <path class="body-arm arm-right" d="M148 48 L178 77 L204 61"></path>
                    <path class="body-leg leg-left" d="M116 92 L104 133 L92 158"></path>
                    <path class="body-leg leg-right" d="M144 92 L156 133 L168 158"></path>
                    <path class="barbell" d="M38 58 H222"></path>
                    <path class="weight" d="M45 43 V73 M54 39 V77 M206 39 V77 M215 43 V73"></path>
                    <circle class="muscle-glow" cx="113" cy="61" r="10"></circle>
                    <circle class="muscle-glow" cx="147" cy="61" r="10"></circle>
                  </svg>
                  <span class="scene-badge">RÉPÉTITION 08</span>
                </div>
                <strong>Musculation</strong>
                <span>La discipline transformée en progression.</span>
                <p>Répéter, mesurer, ajuster et rester constant : chaque séance construit une progression durable.</p>
                <div class="metric-row"><span>Régularité</span><span>88%</span></div>
                <div class="mini-progress"><span style="--progress:88%"></span></div>
                <small>Force · Patience · Progression</small>
              </article>

              <article class="interest-card interest-card-football">
                <div class="scene-topline"><span>03 / COLLECTIF</span><span class="scene-live">● LIVE</span></div>
                <div class="scene football-scene" aria-hidden="true">
                  <div class="pitch-lines"></div>
                  <div class="player player-one"><span class="player-head"></span><span class="player-body"></span><span class="player-leg player-leg-a"></span><span class="player-leg player-leg-b"></span></div>
                  <div class="player player-two"><span class="player-head"></span><span class="player-body"></span><span class="player-leg player-leg-a"></span><span class="player-leg player-leg-b"></span></div>
                  <div class="player player-three"><span class="player-head"></span><span class="player-body"></span><span class="player-leg player-leg-a"></span><span class="player-leg player-leg-b"></span></div>
                  <div class="pass-line"></div>
                  <div class="ball"><span></span></div>
                </div>
                <strong>Football</strong>
                <span>Le collectif, l’intensité et le mouvement.</span>
                <p>Observer, anticiper et communiquer pour participer à une dynamique qui dépasse l’individu.</p>
                <div class="football-readout"><span>VITESSE</span><strong>92</strong><span>COLLECTIF</span><strong>∞</strong></div>
                <small>Lecture du jeu · Énergie · Coordination</small>
              </article>

              <article class="interest-card interest-card-investments">
                <div class="scene-topline"><span>04 / VISION</span><span class="scene-live">● LIVE</span></div>
                <div class="scene investment-scene" aria-hidden="true">
                  <div class="market-grid"></div>
                  <div class="candles">
                    <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                  </div>
                  <svg class="market-line" viewBox="0 0 280 130" preserveAspectRatio="none">
                    <path d="M5 112 C35 108 38 90 65 94 S95 66 120 76 S155 38 178 52 S215 18 240 31 S260 9 275 4"></path>
                  </svg>
                  <span class="market-pulse"></span>
                  <span class="scene-badge">LONG TERME ↗</span>
                </div>
                <strong>Investissements</strong>
                <span>Analyse, patience et construction long terme.</span>
                <p>Avec mon PEA et mon CTO, je privilégie la diversification, l’analyse et la patience plutôt que la précipitation.</p>
                <div class="investment-readout"><span>STRATÉGIE</span><strong>Patience</strong><span>HORIZON</span><strong>Long terme</strong></div>
                <small>Analyse · Diversification · Vision</small>
              </article>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>

<script>
  type CountryPoint = [name: string, lat: number, lon: number];

  const countries: CountryPoint[] = [
    ["Albanie", 41.15, 20.17],
    ["Algérie", 28.03, 1.66],
    ["Allemagne", 51.16, 10.45],
    ["Belgique", 50.5, 4.47],
    ["Bulgarie", 42.73, 25.49],
    ["Chypre", 35.13, 33.43],
    ["Danemark", 56.26, 9.5],
    ["Espagne", 40.46, -3.75],
    ["France", 46.23, 2.21],
    ["Grèce", 39.07, 21.82],
    ["Hongrie", 47.16, 19.5],
    ["Italie", 41.87, 12.57],
    ["Jersey", 49.19, -2.11],
    ["Luxembourg", 49.82, 6.13],
    ["Monaco", 43.74, 7.42],
    ["Norvège", 60.47, 8.47],
    ["Pologne", 51.92, 19.15],
    ["Portugal", 39.4, -8.22],
    ["Suisse", 46.82, 8.23],
    ["Suède", 60.13, 18.64],
    ["Thaïlande", 15.87, 100.99],
    ["Vietnam", 14.06, 108.28],
    ["Émirats arabes unis", 23.42, 53.85],
    ["États-Unis", 37.09, -95.71],
  ];

  const canvas = document.querySelector<HTMLCanvasElement>("#travel-globe");
  const tooltip = document.querySelector<HTMLElement>("#globe-tooltip");

  if (canvas && tooltip) {
    const ctx = canvas.getContext("2d");
    if (!ctx) {
      throw new Error("Impossible d’initialiser le canvas du globe.");
    }
    let rotation = -18;
    let dragging = false;
    let paused = false;
    let lastX = 0;
    let selectedCountry: CountryPoint | null = null;
    let animationFrame = 0;

    const project = (lat: number, lon: number, angle: number) => {
      const phi = (lat * Math.PI) / 180;
      const lambda = ((lon + angle) * Math.PI) / 180;

      return {
        x: Math.cos(phi) * Math.sin(lambda),
        y: Math.sin(phi),
        z: Math.cos(phi) * Math.cos(lambda),
      };
    };

    const resizeCanvas = () => {
      const dpr = window.devicePixelRatio || 1;
      const width = canvas.clientWidth || 600;
      const height = canvas.clientHeight || 420;

      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      return { width, height };
    };

    const draw = () => {
      const { width, height } = resizeCanvas();
      ctx.clearRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height / 2 - 8;
      const radius = Math.min(width * 0.32, height * 0.43);

      const glow = ctx.createRadialGradient(
        cx - radius * 0.35,
        cy - radius * 0.4,
        8,
        cx,
        cy,
        radius * 1.2,
      );

      glow.addColorStop(0, "#29496b");
      glow.addColorStop(0.65, "#102943");
      glow.addColorStop(1, "#07111f");

      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.fillStyle = glow;
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.clip();

      ctx.strokeStyle = "rgba(125, 211, 252, .2)";
      ctx.lineWidth = 1;

      for (let i = -3; i <= 3; i += 1) {
        ctx.beginPath();
        ctx.ellipse(cx, cy, radius, radius * (0.18 + Math.abs(i) * 0.1), 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      for (let i = -3; i <= 3; i += 1) {
        ctx.beginPath();
        ctx.ellipse(cx, cy, radius * (0.18 + Math.abs(i) * 0.1), radius, 0, 0, Math.PI * 2);
        ctx.stroke();
      }

      countries.forEach(([name, lat, lon]) => {
        const point = project(lat, lon, rotation);

        if (point.z <= -0.05) return;

        const px = cx + point.x * radius;
        const py = cy - point.y * radius;
        const isSelected = selectedCountry?.[0] === name;
        const size = isSelected ? 5.5 : 3.2 + Math.max(point.z, 0) * 2;

        ctx.beginPath();
        ctx.arc(px, py, size + (isSelected ? 9 : 5), 0, Math.PI * 2);
        ctx.fillStyle = isSelected
          ? "rgba(251, 191, 36, .24)"
          : "rgba(56, 189, 248, .16)";
        ctx.fill();

        ctx.beginPath();
        ctx.arc(px, py, size, 0, Math.PI * 2);
        ctx.fillStyle = isSelected ? "#fbbf24" : "#7dd3fc";
        ctx.fill();

        ctx.strokeStyle = isSelected ? "#fef3c7" : "#e0f2fe";
        ctx.lineWidth = isSelected ? 2 : 1;
        ctx.stroke();
      });

      ctx.restore();

      // Orbites lumineuses autour du globe.
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(rotation * Math.PI / 540);
      ctx.strokeStyle = "rgba(56, 189, 248, .28)";
      ctx.lineWidth = 1;
      for (const tilt of [-0.55, 0.55]) {
        ctx.save();
        ctx.rotate(tilt);
        ctx.beginPath();
        ctx.ellipse(0, 0, radius * 1.18, radius * 0.34, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }
      ctx.restore();

      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(125, 211, 252, .4)";
      ctx.lineWidth = 1;
      ctx.stroke();

      ctx.fillStyle = "rgba(125, 211, 252, .65)";
      ctx.font = "11px sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("PAYS VISITÉS", cx, cy + radius + 32);
    };

    const getCountryAtPosition = (event: PointerEvent | MouseEvent): CountryPoint | null => {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const width = canvas.clientWidth || 600;
      const height = canvas.clientHeight || 420;
      const cx = width / 2;
      const cy = height / 2 - 8;
      const radius = Math.min(width * 0.32, height * 0.43);

      let nearest: CountryPoint | null = null;
      let nearestDistance = Infinity;

      countries.forEach(([name, lat, lon]) => {
        const point = project(lat, lon, rotation);
        if (point.z <= 0) return;

        const px = cx + point.x * radius;
        const py = cy - point.y * radius;
        const distance = Math.hypot(px - x, py - y);

        if (distance < nearestDistance && distance < 18) {
          nearestDistance = distance;
          nearest = [name, lat, lon];
        }
      });

      return nearest;
    };

    const animate = () => {
      if (!paused && !dragging) rotation += 0.075;
      draw();
      animationFrame = requestAnimationFrame(animate);
    };

    canvas.addEventListener("pointerenter", () => {
      paused = true;
    });

    canvas.addEventListener("pointerleave", () => {
      if (!dragging) paused = false;
    });

    canvas.addEventListener("pointerdown", (event: PointerEvent) => {
      dragging = true;
      paused = true;
      lastX = event.clientX;
      canvas.setPointerCapture(event.pointerId);
    });

    canvas.addEventListener("pointermove", (event: PointerEvent) => {
      if (!dragging) return;
      rotation += (event.clientX - lastX) * 0.45;
      lastX = event.clientX;
    });

    canvas.addEventListener("pointerup", () => {
      dragging = false;
      paused = false;
    });

    canvas.addEventListener("pointercancel", () => {
      dragging = false;
      paused = false;
    });

    canvas.addEventListener("click", (event: MouseEvent) => {
      const country = getCountryAtPosition(event);

      if (!country) {
        selectedCountry = null;
        tooltip.textContent = "Clique sur un point pour découvrir le pays";
        draw();
        return;
      }

      selectedCountry = country;
      tooltip.textContent = `${country[0]} · pays visité`;
      draw();
    });

    window.addEventListener("resize", draw);
    animate();
  }
</script>

